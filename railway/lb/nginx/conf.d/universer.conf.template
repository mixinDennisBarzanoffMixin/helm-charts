upstream universer {
    least_conn;
    server ${UNIVERSER_UPSTREAM} max_fails=30 fail_timeout=15s;
}

upstream veritly_usip {
    least_conn;
    server ${USIP_UPSTREAM} max_fails=30 fail_timeout=15s;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 8000;

    # resolver 127.0.0.11 valid=10s;
    # resolver_timeout 5s;

    client_max_body_size 100m;

    location /v1/files/ {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin $http_origin always;
            add_header Access-Control-Allow-Credentials "true" always;
            add_header Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS" always;
            add_header Access-Control-Allow-Headers $http_access_control_request_headers always;
            add_header Vary "Origin, Access-Control-Request-Headers" always;
            return 204;
        }

        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin $http_origin always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Vary "Origin, Access-Control-Request-Headers" always;
        proxy_pass http://veritly_usip;
    }

    location / {
        proxy_pass http://universer;
    }

    location /universer-api/comb/connect {
        proxy_pass http://universer;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location /universer-api/metrics {
        return 403;
    }
}
