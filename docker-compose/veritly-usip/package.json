{
  "name": "veritly-usip",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --sourcemap --sources-content --outfile=dist/index.js --packages=external",
    "start": "node dist/index.js",
    "start:dev": "node --import tsx/esm src/index.ts",
    "typecheck": "bun x tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.10.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "esbuild": "^0.25.5",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2"
  }
}
